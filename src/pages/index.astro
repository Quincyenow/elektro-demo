---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';
import { business } from '../data/business.ts';
---

<Layout
  title="Gespräch & Wirkung – Conversation Leadership Coaching"
  description="Führe jedes Gespräch mit Klarheit, Präsenz und Wirkung. Professionelles Conversation Leadership Coaching für Führungskräfte, Teams und Selbstständige – deutschlandweit und online."
  canonicalPath="/"
>

<style>
  /* ── Navigation ── */
  nav{position:fixed;top:0;left:0;right:0;z-index:100;display:flex;align-items:center;justify-content:space-between;padding:1rem 1.5rem;background:rgba(13,13,13,0.95);backdrop-filter:blur(12px);border-bottom:1px solid rgba(255,255,255,0.06)}
  .nav-logo{font-family:'Syne',sans-serif;font-weight:800;font-size:1.1rem;letter-spacing:-0.02em;text-decoration:none;color:var(--white)}
  .nav-logo span{color:var(--yellow)}
  .nav-links{display:flex;gap:2rem;align-items:center}
  .nav-links a{font-size:0.85rem;color:var(--text-muted);text-decoration:none;transition:color 0.2s}
  .nav-links a:hover{color:var(--white)}
  .nav-cta{background:var(--yellow);color:var(--black);padding:0.5rem 1.2rem;border-radius:6px;font-size:0.85rem;font-weight:600;text-decoration:none;transition:background 0.2s;white-space:nowrap}
  .nav-cta:hover{background:var(--yellow-dark)}
  .nav-right{display:flex;align-items:center;gap:1rem}
  .hamburger{display:none;flex-direction:column;gap:5px;cursor:pointer;background:none;border:none;padding:4px}
  .hamburger span{display:block;width:22px;height:2px;background:var(--white);transition:all 0.3s}
  .hamburger.open span:nth-child(1){transform:translateY(7px) rotate(45deg)}
  .hamburger.open span:nth-child(2){opacity:0}
  .hamburger.open span:nth-child(3){transform:translateY(-7px) rotate(-45deg)}
  .mobile-menu{display:none;position:fixed;top:60px;left:0;right:0;z-index:99;background:rgba(13,13,13,0.98);backdrop-filter:blur(12px);border-bottom:1px solid rgba(255,255,255,0.06);flex-direction:column;padding:1.5rem;gap:1rem}
  .mobile-menu.open{display:flex}
  .mobile-menu a{font-size:1rem;color:var(--text-muted);text-decoration:none;padding:0.5rem 0;border-bottom:1px solid rgba(255,255,255,0.06)}
  .mobile-menu a:last-child{border-bottom:none}
  .mobile-menu .nav-cta{text-align:center;margin-top:0.5rem;padding:0.8rem;font-size:0.95rem}

  /* ── Hero ── */
  .hero{min-height:100vh;display:grid;grid-template-columns:1fr 1fr;align-items:center;padding:7rem 2rem 4rem;gap:3rem;max-width:1200px;margin:0 auto}
  .hero-eyebrow{display:inline-flex;align-items:center;gap:0.5rem;font-size:0.75rem;font-weight:500;letter-spacing:0.08em;text-transform:uppercase;color:var(--yellow);margin-bottom:1.5rem}
  .hero-eyebrow::before{content:'';width:24px;height:2px;background:var(--yellow);flex-shrink:0}
  .hero h1{font-family:'Syne',sans-serif;font-weight:800;font-size:clamp(2.2rem,5vw,4rem);line-height:1.05;letter-spacing:-0.03em;margin-bottom:1.5rem;overflow-wrap:break-word;word-break:break-word}
  .hero h1 em{color:var(--yellow);font-style:normal}
  .hero-sub{color:var(--text-muted);font-size:1rem;max-width:420px;margin-bottom:2rem;line-height:1.7}
  .hero-actions{display:flex;gap:1rem;flex-wrap:wrap}
  .hero-trust{display:flex;align-items:center;gap:1rem;margin-top:2rem;flex-wrap:wrap}
  .hero-trust-item{display:flex;align-items:center;gap:0.4rem;font-size:0.78rem;color:var(--text-muted)}
  .hero-trust-item::before{content:'✓';color:var(--yellow);font-weight:700;font-size:0.9rem}
  .btn-primary{background:var(--yellow);color:var(--black);padding:0.85rem 1.8rem;border-radius:8px;font-weight:600;font-size:0.9rem;text-decoration:none;transition:background 0.2s,transform 0.15s;display:inline-block}
  .btn-primary:hover{background:var(--yellow-dark);transform:translateY(-1px)}
  .btn-ghost{border:1px solid rgba(255,255,255,0.15);padding:0.85rem 1.8rem;border-radius:8px;font-size:0.9rem;color:var(--white);text-decoration:none;transition:border-color 0.2s,background 0.2s;display:inline-block}
  .btn-ghost:hover{border-color:rgba(255,255,255,0.4);background:rgba(255,255,255,0.04)}
  .hero-visual{position:relative;border-radius:16px;overflow:hidden;aspect-ratio:4/3;background:var(--gray);display:flex;align-items:center;justify-content:center}
  .hero-visual-inner{width:100%;height:100%;background:linear-gradient(135deg,#1a1a1a 0%,#111 50%,#1c1a0f 100%);display:flex;align-items:center;justify-content:center;position:relative}
  .hero-visual-quote{text-align:center;padding:2rem;position:relative;z-index:1}
  .hero-visual-quote blockquote{font-family:'Syne',sans-serif;font-size:clamp(1.1rem,2.5vw,1.6rem);font-weight:700;line-height:1.3;color:var(--white);margin-bottom:1rem;letter-spacing:-0.02em}
  .hero-visual-quote blockquote em{color:var(--yellow);font-style:normal}
  .hero-visual-attr{font-size:0.78rem;color:var(--text-muted);letter-spacing:0.04em}
  .hero-visual-deco{position:absolute;inset:0;background:radial-gradient(ellipse at 60% 40%,rgba(245,200,66,0.07) 0%,transparent 70%);pointer-events:none}
  .hero-badge{position:absolute;bottom:1.5rem;left:1.5rem;right:1.5rem;background:rgba(13,13,13,0.88);backdrop-filter:blur(8px);border:1px solid rgba(255,255,255,0.1);border-radius:10px;padding:0.75rem 1rem;display:flex;justify-content:space-around;gap:0.5rem}
  .badge-stat{text-align:center}
  .badge-stat-num{font-family:'Syne',sans-serif;font-weight:800;font-size:1.1rem;color:var(--yellow)}
  .badge-stat-label{font-size:0.65rem;color:var(--text-muted);letter-spacing:0.04em}

  /* ── Ticker ── */
  .ticker-wrap{background:var(--yellow);overflow:hidden;padding:0.65rem 0}
  .ticker{display:flex;gap:3rem;white-space:nowrap;animation:tick 28s linear infinite}
  @keyframes tick{from{transform:translateX(0)}to{transform:translateX(-50%)}}
  .ticker-item{font-size:0.75rem;font-weight:600;color:var(--black);letter-spacing:0.04em;text-transform:uppercase}
  .ticker-dot{color:rgba(0,0,0,0.3);margin:0 0.5rem}

  /* ── Shared section styles ── */
  .section{padding:4rem 1.5rem;max-width:1200px;margin:0 auto}
  .section-full{padding:4rem 1.5rem;background:var(--gray-mid)}
  .section-full-inner{max-width:1200px;margin:0 auto}
  .section-eye{font-size:0.72rem;font-weight:500;letter-spacing:0.1em;text-transform:uppercase;color:var(--yellow);margin-bottom:0.75rem}
  .section-title{font-family:'Syne',sans-serif;font-weight:800;font-size:clamp(1.6rem,3vw,2.6rem);letter-spacing:-0.02em;margin-bottom:1rem;overflow-wrap:break-word}
  .section-sub{color:var(--text-muted);max-width:480px;line-height:1.7;margin-bottom:2.5rem}

  /* ── About ── */
  .about-grid{display:grid;grid-template-columns:1fr 1fr;gap:4rem;align-items:center}
  .about-text p{color:var(--text-muted);line-height:1.8;margin-bottom:1rem}
  .about-stats{display:grid;grid-template-columns:1fr 1fr;gap:1rem}
  .stat-card{background:var(--gray);border:1px solid rgba(255,255,255,0.06);border-radius:12px;padding:1.5rem}
  .stat-num{font-family:'Syne',sans-serif;font-weight:800;font-size:2rem;color:var(--yellow)}
  .stat-label{font-size:0.8rem;color:var(--text-muted);margin-top:0.2rem}

  /* ── Mid-page CTA Banner ── */
  .cta-banner{background:var(--yellow);padding:4rem 1.5rem;text-align:center}
  .cta-banner-inner{max-width:680px;margin:0 auto}
  .cta-banner h2{font-family:'Syne',sans-serif;font-weight:800;font-size:clamp(1.8rem,4vw,2.8rem);letter-spacing:-0.03em;color:var(--black);line-height:1.1;margin-bottom:1rem}
  .cta-banner p{font-size:1rem;color:rgba(13,13,13,0.7);margin-bottom:2rem;line-height:1.6}
  .btn-dark{background:var(--black);color:var(--yellow);padding:1rem 2.4rem;border-radius:8px;font-weight:700;font-size:1rem;text-decoration:none;display:inline-block;transition:background 0.2s,transform 0.15s}
  .btn-dark:hover{background:#1a1a1a;transform:translateY(-2px)}
  .cta-banner-note{margin-top:1rem;font-size:0.8rem;color:rgba(13,13,13,0.55)}
  .cta-banner-stats{display:flex;justify-content:center;gap:2.5rem;margin-bottom:2rem;flex-wrap:wrap}
  .cta-bs{text-align:center}
  .cta-bs-num{font-family:'Syne',sans-serif;font-weight:800;font-size:1.6rem;color:var(--black)}
  .cta-bs-label{font-size:0.75rem;color:rgba(13,13,13,0.6);letter-spacing:0.04em}

  /* ── Services ── */
  .services-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:1rem}
  .service-card{background:var(--gray);border:1px solid rgba(255,255,255,0.06);border-radius:12px;padding:1.5rem;transition:border-color 0.2s,transform 0.2s}
  .service-card:hover{border-color:var(--yellow);transform:translateY(-3px)}
  .service-icon{font-size:1.5rem;margin-bottom:0.75rem}
  .service-name{font-weight:600;font-size:0.95rem}
  .service-desc{font-size:0.82rem;color:var(--text-muted);margin-top:0.4rem;line-height:1.5}

  /* ── Process / Methode ── */
  .process-steps{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem}
  .step{background:var(--gray);border:1px solid rgba(255,255,255,0.06);border-radius:12px;padding:1.5rem}
  .step-num{width:36px;height:36px;border-radius:50%;background:var(--yellow);color:var(--black);display:flex;align-items:center;justify-content:center;font-family:'Syne',sans-serif;font-weight:800;font-size:0.85rem;margin-bottom:0.75rem;flex-shrink:0}
  .step-title{font-weight:600;margin-bottom:0.4rem;font-size:0.9rem}
  .step-desc{font-size:0.82rem;color:var(--text-muted);line-height:1.5}

  /* ── Reviews ── */
  .reviews-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}
  .review-card{background:var(--gray);border:1px solid rgba(255,255,255,0.06);border-radius:12px;padding:1.5rem}
  .review-stars{color:var(--yellow);font-size:0.9rem;margin-bottom:1rem}
  .review-text{font-size:0.88rem;color:var(--text-muted);line-height:1.7;margin-bottom:1rem;font-style:italic}
  .review-author{font-size:0.82rem;font-weight:600}
  .review-role{font-size:0.78rem;color:var(--text-muted);margin-top:0.15rem}

  /* ── Contact ── */
  .contact-wrap{background:var(--gray);border:1px solid rgba(255,255,255,0.06);border-radius:16px;padding:2.5rem;display:grid;grid-template-columns:1fr 1fr;gap:3rem;align-items:start}
  .contact-info p{color:var(--text-muted);margin-bottom:1rem;font-size:0.9rem;line-height:1.7}
  .contact-detail{display:flex;align-items:center;gap:0.75rem;margin-bottom:0.75rem}
  .contact-detail-icon{width:36px;height:36px;border-radius:8px;background:rgba(245,200,66,0.12);display:flex;align-items:center;justify-content:center;font-size:1rem;flex-shrink:0}
  .contact-detail-text{font-size:0.88rem;color:var(--text-muted)}
  .contact-detail-text strong{color:var(--white);display:block;font-size:0.92rem}
  .contact-quick{display:flex;gap:0.75rem;margin-top:1.5rem;flex-wrap:wrap}
  .contact-quick .btn-ghost{flex:1;text-align:center;padding:0.7rem 1rem;font-size:0.85rem}

  /* ── Footer ── */
  footer{border-top:1px solid rgba(255,255,255,0.06);padding:1.5rem 2rem;display:flex;justify-content:space-between;align-items:center;max-width:1200px;margin:0 auto}
  .footer-logo{font-family:'Syne',sans-serif;font-weight:800;font-size:1rem;text-decoration:none;color:var(--white)}
  .footer-logo span{color:var(--yellow)}
  .footer-copy{font-size:0.8rem;color:var(--text-muted)}
  .footer-links{display:flex;gap:1.5rem}
  .footer-links a{font-size:0.8rem;color:var(--text-muted);text-decoration:none;transition:color 0.2s}
  .footer-links a:hover{color:var(--white)}

  /* ── Responsive ── */
  @media(max-width:768px){
    .nav-links{display:none}
    .hamburger{display:flex}
    nav{padding:0.9rem 1.2rem}
    .hero{grid-template-columns:1fr;min-height:auto;padding:5.5rem 1.2rem 3rem;gap:2rem}
    .hero-visual{aspect-ratio:16/9;border-radius:12px}
    .hero h1{font-size:clamp(2rem,8vw,2.8rem)}
    .hero-sub{max-width:100%}
    .hero-actions{flex-direction:column}
    .hero-actions a{text-align:center}
    .hero-trust{justify-content:flex-start}
    .section{padding:3rem 1.2rem}
    .section-full{padding:3rem 1.2rem}
    .cta-banner{padding:3rem 1.2rem}
    .cta-banner-stats{gap:1.5rem}
    .about-grid{grid-template-columns:1fr;gap:2rem}
    .process-steps{grid-template-columns:1fr 1fr}
    .reviews-grid{grid-template-columns:1fr}
    .contact-wrap{grid-template-columns:1fr;padding:1.5rem;gap:2rem}
    .contact-quick{flex-direction:column}
    footer{flex-direction:column;gap:1rem;text-align:center;padding:1.5rem}
    .footer-links{justify-content:center}
  }
  @media(max-width:400px){
    .hero h1{font-size:1.9rem}
    .process-steps{grid-template-columns:1fr}
    .hero-badge{display:none}
    .cta-banner-stats{flex-direction:column;gap:1rem}
  }
</style>

<!-- Navigation -->
<nav>
  <a href="/" class="nav-logo">💬 Gespräch &amp; <span>Wirkung</span></a>
  <div class="nav-links">
    <a href="#angebote">Angebote</a>
    <a href="#methode">Methode</a>
    <a href="#stimmen">Stimmen</a>
    <a href="#kontakt">Kontakt</a>
  </div>
  <div class="nav-right">
    <a href="#kontakt" class="nav-cta">Erstgespräch buchen</a>
    <button class="hamburger" id="hamburger" aria-label="Menü öffnen">
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>

<div class="mobile-menu" id="mobile-menu">
  <a href="#angebote" class="mobile-link">Angebote</a>
  <a href="#methode" class="mobile-link">Methode</a>
  <a href="#stimmen" class="mobile-link">Stimmen</a>
  <a href="#kontakt" class="mobile-link">Kontakt</a>
  <a href="#kontakt" class="nav-cta">Kostenloses Erstgespräch</a>
</div>

<!-- Hero -->
<div class="hero">
  <div class="hero-content">
    <div class="hero-eyebrow">Conversation Leadership Coaching</div>
    <h1>Führe jedes Gespräch mit <em>Klarheit</em> und <em>Wirkung</em>.</h1>
    <p class="hero-sub">Ob schwierige Mitarbeitergespräche, entscheidende Verhandlungen oder Präsentationen — lerne, Gespräche souverän zu leiten und bleibenden Eindruck zu hinterlassen.</p>
    <div class="hero-actions">
      <a href="#kontakt" class="btn-primary">Kostenloses Erstgespräch →</a>
      <a href="#angebote" class="btn-ghost">Angebote ansehen</a>
    </div>
    <div class="hero-trust">
      <span class="hero-trust-item">Kostenlos &amp; unverbindlich</span>
      <span class="hero-trust-item">ICF-zertifiziert</span>
      <span class="hero-trust-item">Online &amp; Präsenz</span>
    </div>
  </div>
  <div class="hero-visual">
    <div class="hero-visual-inner">
      <div class="hero-visual-deco"></div>
      <div class="hero-visual-quote">
        <blockquote>„Wer das Gespräch<br>führt, führt<br><em>die Situation.</em>"</blockquote>
        <p class="hero-visual-attr">— Kernprinzip des Conversation Leadership</p>
      </div>
    </div>
    <div class="hero-badge">
      <div class="badge-stat"><div class="badge-stat-num">8+</div><div class="badge-stat-label">Jahre Coaching</div></div>
      <div class="badge-stat"><div class="badge-stat-num">1.200+</div><div class="badge-stat-label">Klienten</div></div>
      <div class="badge-stat"><div class="badge-stat-num">98%</div><div class="badge-stat-label">Empfehlen uns</div></div>
    </div>
  </div>
</div>

<!-- Ticker -->
<div class="ticker-wrap">
  <div class="ticker">
    <span class="ticker-item">Kostenloses Erstgespräch <span class="ticker-dot">•</span></span>
    <span class="ticker-item">{business.phone} <span class="ticker-dot">•</span></span>
    <span class="ticker-item">Online &amp; deutschlandweit <span class="ticker-dot">•</span></span>
    <span class="ticker-item">ICF-zertifiziertes Coaching <span class="ticker-dot">•</span></span>
    <span class="ticker-item">Führungskräfte · Teams · Selbstständige <span class="ticker-dot">•</span></span>
    <span class="ticker-item">Kostenloses Erstgespräch <span class="ticker-dot">•</span></span>
    <span class="ticker-item">{business.phone} <span class="ticker-dot">•</span></span>
    <span class="ticker-item">Online &amp; deutschlandweit <span class="ticker-dot">•</span></span>
    <span class="ticker-item">ICF-zertifiziertes Coaching <span class="ticker-dot">•</span></span>
    <span class="ticker-item">Führungskräfte · Teams · Selbstständige <span class="ticker-dot">•</span></span>
  </div>
</div>

<!-- About -->
<div class="section" id="about">
  <div class="about-grid">
    <div class="about-text">
      <div class="section-eye">Über das Coaching</div>
      <h2 class="section-title">Gespräche sind Führung — lerne sie zu <em style="color:var(--yellow);font-style:normal">meistern</em></h2>
      <p>Jede Entscheidung, jede Zusammenarbeit, jeder Konflikt — alles beginnt mit einem Gespräch. Wer Gespräche bewusst führt, führt Menschen, Teams und Ergebnisse.</p>
      <p>Mit über 8 Jahren Erfahrung und mehr als 1.200 begleiteten Klientinnen und Klienten aus Wirtschaft, Führung und Selbstständigkeit entwickeln wir eine Methode, die sofort wirkt — im Meeting, im Mitarbeitergespräch, im Alltag.</p>
      <br>
      <a href="#kontakt" class="btn-primary">Kostenloses Erstgespräch vereinbaren →</a>
    </div>
    <div class="about-stats">
      <div class="stat-card"><div class="stat-num">8+</div><div class="stat-label">Jahre Coaching-Erfahrung</div></div>
      <div class="stat-card"><div class="stat-num">1.200+</div><div class="stat-label">Begleitete Klienten</div></div>
      <div class="stat-card"><div class="stat-num">98%</div><div class="stat-label">Weiterempfehlungsrate</div></div>
      <div class="stat-card"><div class="stat-num">4</div><div class="stat-label">Länder aktiv</div></div>
    </div>
  </div>
</div>

<!-- ── Prominent CTA Banner ── -->
<div class="cta-banner" id="cta-primary">
  <div class="cta-banner-inner">
    <div class="cta-banner-stats">
      <div class="cta-bs"><div class="cta-bs-num">30 Min</div><div class="cta-bs-label">Kostenlos & unverbindlich</div></div>
      <div class="cta-bs"><div class="cta-bs-num">100%</div><div class="cta-bs-label">Individuell auf dich zugeschnitten</div></div>
      <div class="cta-bs"><div class="cta-bs-num">Sofort</div><div class="cta-bs-label">Erste Impulse im Gespräch</div></div>
    </div>
    <h2>Bereit, jedes Gespräch zu gewinnen?</h2>
    <p>Vereinbare jetzt dein kostenloses 30-minütiges Erstgespräch. Wir analysieren deine aktuelle Kommunikationssituation und zeigen dir, welche Hebel sofort wirken.</p>
    <a href="#kontakt" class="btn-dark">Jetzt Erstgespräch buchen</a>
    <p class="cta-banner-note">Keine Kreditkarte. Keine Verpflichtung. Einfach ein ehrliches Gespräch.</p>
  </div>
</div>

<!-- Services / Angebote -->
<div class="section-full" id="angebote">
  <div class="section-full-inner">
    <div class="section-eye">Angebote</div>
    <h2 class="section-title">Was du bei uns lernst</h2>
    <p class="section-sub">Von der Einzelbegleitung bis zum Team-Workshop — wähle das Format, das zu dir passt.</p>
    <div class="services-grid">
      <div class="service-card"><div class="service-icon">🎯</div><div class="service-name">Einzelcoaching</div><div class="service-desc">1:1 Sessions für maximale persönliche Wirkung in jedem Gespräch</div></div>
      <div class="service-card"><div class="service-icon">💼</div><div class="service-name">Führungskräfte-Coaching</div><div class="service-desc">Autoritativ führen und überzeugend kommunizieren auf Top-Level</div></div>
      <div class="service-card"><div class="service-icon">🗣️</div><div class="service-name">Kommunikationstraining</div><div class="service-desc">Gruppentraining für Teams — praxisnah und sofort anwendbar</div></div>
      <div class="service-card"><div class="service-icon">🎓</div><div class="service-name">Online-Kurs</div><div class="service-desc">Selbstlernprogramm: Conversation Leadership im eigenen Tempo</div></div>
      <div class="service-card"><div class="service-icon">🤝</div><div class="service-name">Team-Workshop</div><div class="service-desc">Gesprächskultur im Team dauerhaft verbessern</div></div>
      <div class="service-card"><div class="service-icon">🧠</div><div class="service-name">Schwierige Gespräche</div><div class="service-desc">Konflikte deeskalieren, Klartext reden, Lösungen erzielen</div></div>
      <div class="service-card"><div class="service-icon">🎤</div><div class="service-name">Präsentation & Vortrag</div><div class="service-desc">Überzeugend auftreten vor jedem Publikum</div></div>
