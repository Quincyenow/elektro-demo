---
import CoachLayout from '../layouts/CoachLayout.astro';
import { coach } from '../data/coach.ts';

const iconMap: Record<string, string> = {
  heart: '♥', mail: '✉', play: '▶', eye: '◉', star: '★',
};
const initials = (name: string) =>
  name.replace(/[^A-Za-zÄÖÜäöü. ]/g, '').split(' ').slice(0, 2).map((w) => w[0]).join('').toUpperCase();
const stars = (r: number) => Array.from({ length: 5 }, (_, i) => (i < Math.round(r) ? 'on' : 'off'));
---

<CoachLayout>
  <!-- ===================== HEADER ===================== -->
  <header class="site-header">
    <div class="wrap bar">
      <a class="logo" href="/">
        <img src="/logo.svg" alt="Flirt Psychologie" />
      </a>
      <nav class="nav">
        {coach.nav.map((n) => <a href={n.href}>{n.label}</a>)}
      </nav>
      <a class="header-phone" href={`tel:${coach.phoneHref}`}>
        <span class="ic">✆</span>{coach.phone}
      </a>
      <button class="burger" aria-label="Menü" onclick="document.querySelector('.nav').classList.toggle('open')">☰</button>
    </div>
  </header>

  <!-- ===================== STATS ===================== -->
  <div class="stats">
    <div class="wrap grid">
      {coach.stats.map((s) => (
        <div class="stat">
          <span class="si">{iconMap[s.icon]}</span>
          <span><b>{s.value}</b><span>{s.label}</span></span>
        </div>
      ))}
    </div>
  </div>

  <!-- ===================== HERO ===================== -->
  <section class="hero">
    <span class="streak s1"></span><span class="streak s2"></span><span class="streak s3"></span>
    <div class="wrap inner">
      <div class="hero-copy">
        <span class="eyebrow">{coach.hero.kicker}</span>
        <h1>{coach.hero.title}</h1>
        <p class="lead">{coach.hero.text}</p>
        <p class="hl">{coach.hero.highlight}</p>
        <a class="btn btn-gold" href={coach.hero.ctaHref}>
          <span class="arw">→</span>{coach.hero.cta}
        </a>
        <div class="trust"><span class="stars">★★★★★</span> Über 14.000 zufriedene Klienten</div>
      </div>
      <div class="hero-photo">
        <div class="glow"></div>
        <img src={coach.hero.image} alt={coach.name} width="440" height="600" />
      </div>
    </div>
  </section>

  <!-- ===================== ABOUT ===================== -->
  <section class="section about" id="ueber">
    <div class="wrap inner">
      <div class="about-photo">
        <div class="ring"></div>
        <div class="disc"><img src={coach.about.photo} alt={coach.name} /></div>
      </div>
      <div>
        <h2>{coach.about.title}</h2>
        <p>… <span class="lead-em">{coach.about.lead}</span> {coach.about.text}</p>
        <div class="sign">{coach.about.signoff}<div class="name">{coach.about.signature}</div></div>
      </div>
    </div>
  </section>

  <!-- ===================== TESTIMONIALS ===================== -->
  <section class="section testi">
    <div class="wrap">
      <div class="sec-head"><h2>{coach.testimonialsTitle}</h2></div>
      <div class="testi-grid">
        {coach.testimonials.map((t) => (
          <div class="tcard">
            <div class="q">&ldquo;</div>
            <p>{t.quote}</p>
            <div class="who">
              <img src={coach.about.photo} alt={t.name} />
              <span><b>{t.name}</b><span>{t.role}</span></span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== TOPICS ===================== -->
  <section class="section topics" id="tipps">
    <div class="wrap">
      <div class="sec-head">
        <div class="heart">♥</div>
        <h2>{coach.topicsTitle}</h2>
        <p>{coach.topicsSub}</p>
      </div>
      <div class="topics-grid">
        {coach.topics.map((c) => (
          <div class="tcol">
            <h3>{c.head}</h3>
            {c.links.map((l) => <a href="#artikel">{l}</a>)}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== APPS ===================== -->
  <section class="section apps" id="apps">
    <div class="wrap">
      <div class="sec-head">
        <div class="heart">▢</div>
        <h2>{coach.appsTitle}</h2>
        <p>{coach.appsSub}</p>
      </div>
      <div class="apps-grid">
        {coach.apps.map((a) => (
          <div class="acard">
            <div class="head">
              <span class="rank">{a.rank}</span>
              {a.winner && <span class="winner">Testsieger</span>}
              <span class="logo-box">{a.name}</span>
              <span class="test">Test</span>
              <span class="qsub">{a.question}</span>
              <img class="model" src={coach.hero.image} alt="" />
            </div>
            <div class="appname">{a.name}</div>
            <div class="body">
              <div class="stars">{stars(a.rating).map((s) => <span class={s === 'off' ? 'off' : ''}>★</span>)}</div>
              <p>{a.text}</p>
              <div class="actions">
                <a class="visit" href="#">Seite besuchen</a>
                <a class="report" href="#">Testbericht lesen</a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== POPULAR ARTICLES ===================== -->
  <section class="section articles" id="artikel">
    <div class="wrap">
      <div class="sec-head"><h2>{coach.popularTitle}</h2><p>{coach.popularSub}</p></div>
      <div class="art-grid">
        {coach.popular.map((a) => (
          <article class="article">
            <div class="thumb" style={`background-image:url(${coach.about.photo})`}><span class="cat">{a.cat}</span></div>
            <div class="txt">
              <h3>{a.title}</h3>
              <p>{a.excerpt}</p>
              <a class="more" href="#">Weiterlesen →</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== NEWEST ARTICLES ===================== -->
  <section class="section articles alt">
    <div class="wrap">
      <div class="sec-head"><h2>{coach.newestTitle}</h2></div>
      <div class="art-grid four">
        {coach.newest.map((a) => (
          <article class="article">
            <div class="thumb" style={`background-image:url(${coach.about.photo})`}><span class="cat">{a.cat}</span></div>
            <div class="txt">
              <h3>{a.title}</h3>
              <p>{a.excerpt}</p>
              <a class="more" href="#">Weiterlesen →</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== REFERENCES ===================== -->
  <section class="refs" id="referenzen">
    <div class="mosaic">{Array.from({ length: 60 }).map(() => <i></i>)}</div>
    <div class="wrap inner">
      <h2>{coach.referencesTitle}</h2>
      <p>{coach.referencesText}</p>
      <a class="btn btn-gold" href={coach.referencesCtaHref}><span class="arw">→</span>{coach.referencesCta}</a>
    </div>
  </section>

  <!-- ===================== FOOTER ===================== -->
  <footer class="site-footer" id="kontakt">
    <div class="wrap">
      <div class="footer-cols">
        <div class="foot-brand">
          <a class="logo" href="/"><img src="/logo.svg" alt="Flirt Psychologie" /></a>
          <p>{coach.claim} Psychologisch fundiertes Coaching für Kennenlernen, Anziehung und echte Beziehungen.</p>
        </div>
        <div>
          <h4>Dating-Tipps</h4>
          {coach.topics.slice(0, 6).map((t) => <a href="#tipps">{t.head}</a>)}
        </div>
        <div>
          <h4>Dating-Apps</h4>
          <div class="foot-links">{coach.footer.apps.map((a) => <a href="#apps">{a}</a>)}</div>
        </div>
        <div>
          <h4>Kontakt</h4>
          <a href={`tel:${coach.phoneHref}`}>{coach.phone}</a>
          <a href={`mailto:${coach.email}`}>{coach.email}</a>
          <div style="margin-top:10px">{coach.footer.social.map((s) => <a href={s.href} style="display:inline-block;margin-right:14px">{s.label}</a>)}</div>
        </div>
      </div>
      <div class="foot-bottom">
        <span>© {new Date().getFullYear()} {coach.name} · {coach.role}</span>
        <span class="legal">{coach.footer.legal.map((l) => <a href={l.href}>{l.label}</a>)}</span>
      </div>
    </div>
  </footer>
</CoachLayout>
