# ── Instagram Webhook — Environment Variables ──────────────────────────────────
# Copy this file to .env and fill in real values. Never commit .env.

# Arbitrary secret string you choose and paste into the Meta App Dashboard
# under Webhooks → Edit Subscription → Verify Token.
INSTAGRAM_VERIFY_TOKEN=your_random_verify_token_here

# Long-lived Page access token (or System User token) with permissions:
#   instagram_manage_messages, instagram_basic, pages_messaging
# Generate at: https://developers.facebook.com/tools/explorer/
INSTAGRAM_ACCESS_TOKEN=EAAxxxxxxxx...

# Your Meta App Secret — found in App Dashboard → Settings → Basic.
# Used to verify X-Hub-Signature-256 on incoming payloads. Recommended.
INSTAGRAM_APP_SECRET=your_app_secret_here

# Numeric ID of your Instagram Business / Creator Account.
# Find it at: https://www.instagram.com/api/v1/users/web_profile_info/?username=YOUR_HANDLE
# or via Graph API: GET /me?fields=id&access_token=YOUR_TOKEN
INSTAGRAM_PAGE_ID=123456789012345

# HTTP port for the webhook server (default: 3000)
PORT=3000
